#include <WiFi.h>
#include <PubSubClient.h>
#include <DHT.h>

// --- YOUR EXACT PIN DEFINITIONS ---
#define DHTPIN 4          
#define DHTTYPE DHT11     
#define MOISTURE_PIN 32   
#define PH_POT_PIN 33     
#define TDS_PIN 34        
#define LIGHT_PIN 35      

// --- WI-FI & MQTT CONFIGURATION ---
const char* ssid = "Galaxy A33 5GF06F";          // Enter your Wi-Fi or Hotspot name
const char* password = "vywa6030";  // Enter your Wi-Fi password
const char* mqtt_server = "broker.hivemq.com"; // Free public broker for testing
const int mqtt_port = 1883;
const char* mqtt_topic = "agritwin/sensors/live"; // The "channel" we publish to

WiFiClient espClient;
PubSubClient client(espClient);
DHT dht(DHTPIN, DHTTYPE);

// Function to connect to Wi-Fi
void setup_wifi() {
  delay(10);
  Serial.println();
  Serial.print("Connecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi connected!");
}

// Function to reconnect to MQTT if connection drops
void reconnect() {
  while (!client.connected()) {
    Serial.print("Attempting MQTT connection...");
    // Create a random client ID
    String clientId = "AgriTwinNode-";
    clientId += String(random(0xffff), HEX);
    
    // Attempt to connect
    if (client.connect(clientId.c_str())) {
      Serial.println("connected");
    } else {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      Serial.println(" try again in 5 seconds");
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  dht.begin();
  analogReadResolution(12);
  
  // Setup Network
  setup_wifi();
  client.setServer(mqtt_server, mqtt_port);
}

void loop() {
  // Ensure MQTT remains connected
  if (!client.connected()) {
    reconnect();
  }
  client.loop();

  // --- Read All Sensors (Same logic as before) ---
  float temp = dht.readTemperature(); 
  float hum = dht.readHumidity();     
  if (isnan(temp) || isnan(hum)) { temp = 0.0; hum = 0.0; }

  int soilRaw = analogRead(MOISTURE_PIN);
  int soilPercent = constrain(map(soilRaw, 2450, 800, 0, 100), 0, 100); // Custom Calibration 

  int phRaw = analogRead(PH_POT_PIN);
  float phValue = (phRaw / 4095.0) * 14.0;

  int tdsRaw = analogRead(TDS_PIN);
  float voltage = tdsRaw * (3.3 / 4095.0);
  float tdsValue = (133.42 * pow(voltage, 3) - 255.86 * pow(voltage, 2) + 857.39 * voltage) * 0.5;
  float salinity = tdsValue / 640.0;

  int lightRaw = analogRead(LIGHT_PIN);
  int lightPercent = constrain(map(lightRaw, 4095, 0, 0, 100), 0, 100);

  // --- Create JSON String ---
  String payload = "{";
  payload += "\"temperature\": " + String(temp) + ", ";
  payload += "\"humidity\": " + String(hum) + ", ";
  payload += "\"moisture\": " + String(soilPercent) + ", ";
  payload += "\"light\": " + String(lightPercent) + ", ";
  payload += "\"ph\": " + String(phValue, 1) + ", ";
  payload += "\"salinity\": " + String(salinity, 2);
  payload += "}";

  // --- Publish to MQTT Broker ---
  Serial.print("Publishing message: ");
  Serial.println(payload);
  
  // Convert String to char array for PubSubClient
  client.publish(mqtt_topic, payload.c_str());

  // Wait 3 seconds
  delay(3000);
}
